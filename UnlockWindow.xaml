<Window x:Class="AccountManager.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccountManager 解锁" Height="340" Width="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="AccountManager" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="ModeText" Foreground="#666" Margin="0,6,0,0"/>
            <Border Background="#FFF8D7" BorderBrush="#E8D88A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="提示词" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="请输入主密码" FontSize="14" Margin="0,0,0,8"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Height="34" KeyDown="PasswordBox_KeyDown"/>
            <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="Crimson" Margin="0,8,0,0"/>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <Button Content="忘记密码" Width="90" DockPanel.Dock="Left" Click="Recover_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="退出" Width="90" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="解锁" Width="100" IsDefault="True" Click="Unlock_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
