<Window x:Class="AccountManager.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解锁" Height="240" Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AccountManager" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="HintText" Grid.Row="1" Foreground="#666" TextWrapping="Wrap" Margin="0,12,0,8"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Height="30" KeyDown="PasswordBox_KeyDown"/>
        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="Crimson" Margin="0,8,0,0"/>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button Content="忘记密码" Width="86" DockPanel.Dock="Left" Click="Recover_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="退出" Width="72" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="解锁" Width="80" IsDefault="True" Click="Unlock_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
