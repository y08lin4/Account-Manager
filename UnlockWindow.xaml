<Window x:Class="AccountManager.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解锁" Height="260" Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="Stroke" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22" MouseDown="Window_MouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AccountManager" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="HintText" Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,10,0,22"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="DotsPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="Dot1" Style="{StaticResource Dot}"/>
                <Ellipse x:Name="Dot2" Style="{StaticResource Dot}"/>
                <Ellipse x:Name="Dot3" Style="{StaticResource Dot}"/>
                <Ellipse x:Name="Dot4" Style="{StaticResource Dot}"/>
                <Ellipse x:Name="Dot5" Style="{StaticResource Dot}"/>
                <Ellipse x:Name="Dot6" Style="{StaticResource Dot}"/>
            </StackPanel>

            <TextBlock x:Name="VisiblePasswordText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="20"
                       Visibility="Collapsed"/>

            <Button x:Name="ToggleVisibleButton"
                    Grid.Column="1"
                    Content="&#xE890;"
                    FontFamily="Segoe MDL2 Assets"
                    Padding="0"
                    MinWidth="0"
                    Width="34"
                    Height="28"
                    ToolTip="显示/隐藏"
                    Click="ToggleVisible_Click"/>
        </Grid>

        <PasswordBox x:Name="HiddenPasswordBox"
                     Grid.Row="2"
                     Width="1"
                     Height="1"
                     Opacity="0"
                     MaxLength="6"
                     PasswordChanged="HiddenPasswordBox_PasswordChanged"
                     KeyDown="HiddenPasswordBox_KeyDown"/>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource DangerBrush}" TextAlignment="Center" Margin="0,0,0,0"/>

        <DockPanel Grid.Row="5" Margin="0,18,0,0">
            <Button Content="忘记密码" Width="86" DockPanel.Dock="Left" Click="Recover_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="退出" Width="72" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="解锁" Width="80" IsDefault="True" Click="Unlock_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
