<Window x:Class="AccountManager.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解锁" Height="300" Width="440"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AccountManager" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="HintText" Grid.Row="1" Foreground="#666" TextWrapping="Wrap" Margin="0,10,0,18"/>

        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="主密码"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="PasswordBox"
                         Height="34"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#8AAEE8"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         KeyDown="PasswordInput_KeyDown"
                         KeyUp="PasswordInput_KeyUp"
                         GotKeyboardFocus="PasswordInput_GotKeyboardFocus"/>

            <TextBox x:Name="PasswordTextBox"
                     Height="34"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#8AAEE8"
                     Visibility="Collapsed"
                     TextChanged="PasswordTextBox_TextChanged"
                     KeyDown="PasswordInput_KeyDown"
                     KeyUp="PasswordInput_KeyUp"
                     GotKeyboardFocus="PasswordInput_GotKeyboardFocus"/>

            <Button x:Name="TogglePasswordButton"
                    Grid.Column="1"
                    Content="显示"
                    Width="54"
                    Height="34"
                    Margin="6,0,0,0"
                    Click="TogglePassword_Click"/>
        </Grid>

        <TextBlock x:Name="CapsLockText"
                   Grid.Row="4"
                   Text="Caps Lock 已开启"
                   Foreground="#9A6500"
                   Margin="0,6,0,0"
                   Visibility="Collapsed"/>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="Crimson" Margin="0,8,0,0"/>

        <DockPanel Grid.Row="6" Margin="0,14,0,0">
            <Button Content="忘记密码" Width="86" DockPanel.Dock="Left" Click="Recover_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="退出" Width="72" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="解锁" Width="80" IsDefault="True" Click="Unlock_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
