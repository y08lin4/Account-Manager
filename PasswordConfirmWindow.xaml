<Window x:Class="AccountManager.PasswordConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认主密码" Height="180" Width="360"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PurposeText" Text="请输入主密码" FontWeight="SemiBold"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Height="30" Margin="0,12,0,0"/>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="Crimson" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="72" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="确认" Width="80" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
