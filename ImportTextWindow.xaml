<Window x:Class="AccountManager.ImportTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量导入账号" Height="620" Width="760"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="一行一个，格式：邮箱--密码--2FA，也支持 邮箱--密码 或 邮箱--密码--2FA--备注" FontWeight="SemiBold"/>
            <TextBlock Text="导入时不会改变密码大小写；搜索时大小写不敏感。" Foreground="#666" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="默认分类" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="CategoryBox" Grid.Column="1" Height="28" Margin="0,0,16,8"/>
            <TextBlock Grid.Column="2" Text="默认标签" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="TagsBox" Grid.Column="3" Height="28" Margin="0,0,16,8" ToolTip="多个标签用逗号分隔"/>
            <TextBlock Grid.Column="4" Text="重复邮箱" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="DuplicateBox" Grid.Column="5" SelectedIndex="0" Height="28" Margin="0,0,0,8">
                <ComboBoxItem Content="跳过重复"/>
                <ComboBoxItem Content="覆盖重复"/>
                <ComboBoxItem Content="保留两个"/>
            </ComboBox>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="90" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="导入" Width="100" IsDefault="True" Click="Import_Click"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="ImportTextBox" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/>
    </DockPanel>
</Window>
