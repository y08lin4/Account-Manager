<Window x:Class="AccountManager.BatchCategoryTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量分类/标签" Height="260" Width="440" MinHeight="260" MinWidth="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TitleText" Text="批量添加分类和标签" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="ScopeText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="分类" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <TextBox x:Name="CategoryBox" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="标签" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <TextBox x:Name="TagsBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="分类留空不修改；填写分类会设置为该分类。标签会追加并自动去重，多个标签用逗号或分号分隔。"
                       Style="{StaticResource MutedText}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="72" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="应用" Width="86" IsDefault="True" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
