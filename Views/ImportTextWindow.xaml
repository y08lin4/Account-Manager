<Window x:Class="AccountManager.ImportTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入" Height="560" Width="760" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="分类" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CategoryBox"
                      Grid.Column="1"
                      Height="26"
                      IsEditable="True"
                      IsTextSearchEnabled="True"/>
            <TextBlock Grid.Column="2" Text="标签" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox x:Name="TagsBox"
                      Grid.Column="3"
                      Height="26"
                      IsEditable="True"
                      IsTextSearchEnabled="True"/>
            <TextBlock Grid.Column="4" Text="重复" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox x:Name="DuplicateBox" Grid.Column="5" SelectedIndex="0" Height="26" SelectionChanged="DuplicateBox_SelectionChanged">
                <ComboBoxItem Content="跳过"/>
                <ComboBoxItem Content="覆盖"/>
                <ComboBoxItem Content="保留"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="支持 TXT / CSV；邮箱--密码--2FA，或三行一组：邮箱 / 密码 / 2FA" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock x:Name="SourceText" Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="预览" Width="72" Height="26" Margin="0,0,6,0" Click="Preview_Click"/>
                <Button Content="导入" Width="72" Height="26" IsDefault="True" Click="Import_Click"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="ImportTextBox"
                 Grid.Row="2"
                 Style="{StaticResource MultiLineTextBox}"
                 Height="Auto"
                 MinHeight="260"
                 VerticalAlignment="Stretch"
                 AcceptsTab="True"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 SpellCheck.IsEnabled="False"/>

        <Grid Grid.Row="3" Height="92" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PreviewText" Foreground="{StaticResource SubTextBrush}"/>
            <TextBox x:Name="PreviewErrorsBox"
                     Grid.Row="1"
                     Style="{StaticResource MultiLineTextBox}"
                     Height="Auto"
                     Margin="0,4,0,0"
                     IsReadOnly="True"
                     VerticalAlignment="Stretch"
                     BorderBrush="{StaticResource BorderBrushLight}"/>
        </Grid>
    </Grid>
</Window>
