<Window x:Class="AccountManager.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="520" MinWidth="420" MaxWidth="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Border BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar" Background="{StaticResource PrimaryBrush}" CornerRadius="2"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" Margin="0,8,0,0" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Grid>

            <TextBox x:Name="DetailsBox"
                     Grid.Row="1"
                     Margin="16,14,0,0"
                     Style="{StaticResource MultiLineTextBox}"
                     MinLines="4"
                     MaxLines="12"
                     MaxHeight="240"
                     IsReadOnly="True"
                     BorderBrush="{StaticResource BorderBrushLight}"
                     Background="{StaticResource InputReadOnlyBrush}"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Visibility="Collapsed"/>

            <StackPanel x:Name="CopyPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed">
                <Button Content="复制详情" Width="86" Height="28" Click="CopyDetails_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="取消" Width="72" Height="28" Margin="0,0,8,0" Click="Cancel_Click" Visibility="Collapsed"/>
                <Button x:Name="OkButton" Content="确定" Width="72" Height="28" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
