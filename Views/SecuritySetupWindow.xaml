<Window x:Class="AccountManager.SecuritySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置安全保护" Height="430" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Text="首次使用：设置主密码" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="主密码用于解锁软件；保护问题用于忘记主密码时重置。备份恢复后仍需要输入对应主密码。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="主密码" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="确认密码" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="密码提示词" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <TextBox x:Name="HintBox" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,10" ToolTip="解锁界面会显示这个提示词，不要填写完整密码。"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="保护问题" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <TextBox x:Name="QuestionBox" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,10" ToolTip="例如：我的备用提示是什么？"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="保护答案" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <PasswordBox x:Name="AnswerBox" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="确认答案" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <PasswordBox x:Name="ConfirmAnswerBox" Grid.Row="5" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="6" Grid.Column="1" Text="注意：提示词会明文显示；保护答案用于重置主密码，请不要太简单。" Style="{StaticResource MutedText}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="90" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="保存" Width="100" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
