<Window x:Class="AccountManager.SecuritySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置安全保护" Height="400" Width="430" MinHeight="400" MinWidth="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="Stroke" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,22,24,20" MouseDown="Window_MouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Text="设置主密码" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="StepCountText"
                       Grid.Column="1"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="1"
                   Style="{StaticResource MutedText}"
                   Margin="0,8,0,18"/>

        <Grid Grid.Row="2">
            <StackPanel x:Name="PasswordPanel" VerticalAlignment="Center">
                <Grid Height="36" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="DotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot1" Style="{StaticResource Dot}"/>
                        <Ellipse x:Name="Dot2" Style="{StaticResource Dot}"/>
                        <Ellipse x:Name="Dot3" Style="{StaticResource Dot}"/>
                        <Ellipse x:Name="Dot4" Style="{StaticResource Dot}"/>
                        <Ellipse x:Name="Dot5" Style="{StaticResource Dot}"/>
                        <Ellipse x:Name="Dot6" Style="{StaticResource Dot}"/>
                    </StackPanel>

                    <TextBlock x:Name="VisiblePasswordText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="20"
                               Visibility="Collapsed"/>

                    <Button x:Name="ToggleVisibleButton"
                            Grid.Column="1"
                            Content="&#xE890;"
                            FontFamily="Segoe MDL2 Assets"
                            Padding="0"
                            MinWidth="0"
                            Width="34"
                            Height="30"
                            VerticalAlignment="Center"
                            ToolTip="显示/隐藏"
                            Click="ToggleVisible_Click"/>
                </Grid>

                <TextBlock Text="6 位主密码，输入满 6 位自动下一步。"
                           Style="{StaticResource MutedText}"
                           TextAlignment="Center"/>

                <PasswordBox x:Name="HiddenPasswordBox"
                             Width="1"
                             Height="1"
                             Opacity="0"
                             MaxLength="6"
                             PasswordChanged="HiddenPasswordBox_PasswordChanged"
                             KeyDown="HiddenPasswordBox_KeyDown"/>
            </StackPanel>

            <StackPanel x:Name="HintPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="提示词" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="HintBox" Height="32" KeyDown="TextInput_KeyDown"/>
                <TextBlock Text="会显示在解锁页，可留空，不要填写完整密码。"
                           Style="{StaticResource MutedText}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel x:Name="QuestionPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="保护问题" Style="{StaticResource SectionTitle}"/>
                <ComboBox x:Name="QuestionComboBox"
                          Height="32"
                          SelectionChanged="QuestionComboBox_SelectionChanged"/>
                <TextBox x:Name="CustomQuestionBox"
                         Height="32"
                         Margin="0,8,0,0"
                         Visibility="Collapsed"
                         KeyDown="TextInput_KeyDown"/>
                <TextBlock Text="忘记主密码时会显示这个问题。"
                           Style="{StaticResource MutedText}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel x:Name="AnswerPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="AnswerTitleText" Text="保护答案" Style="{StaticResource SectionTitle}"/>
                <PasswordBox x:Name="AnswerInputBox"
                             Height="32"
                             KeyDown="TextInput_KeyDown"/>
                <TextBlock x:Name="AnswerTipText"
                           Text="用于重置主密码，至少 2 个字符。"
                           Style="{StaticResource MutedText}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   MinHeight="20"
                   Foreground="{StaticResource DangerBrush}"
                   TextAlignment="Center"
                   Margin="0,12,0,0"/>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="BackButton"
                    Content="上一步"
                    Width="74"
                    DockPanel.Dock="Left"
                    Click="Back_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="72" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="NextButton"
                        Content="下一步"
                        Width="80"
                        IsDefault="True"
                        Click="Next_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
