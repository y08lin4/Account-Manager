<Window x:Class="AccountManager.BackupHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份历史" Height="420" Width="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="DirectoryText" VerticalAlignment="Center" Foreground="#555" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="刷新" Width="64" Height="28" Margin="8,0,0,0" Click="Refresh_Click"/>
                <Button Content="打开目录" Width="82" Height="28" Margin="8,0,0,0" Click="OpenDirectory_Click"/>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="恢复选中" Width="86" Height="28" Margin="0,0,8,0" Click="RestoreSelected_Click"/>
            <Button Content="删除选中" Width="86" Height="28" Margin="0,0,8,0" Click="DeleteSelected_Click"/>
            <Button Content="关闭" Width="72" Height="28" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="BackupsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#DDD"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="时间" Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
