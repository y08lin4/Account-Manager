<Window x:Class="AccountManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabs">
            <TabItem x:Name="SecurityTab" Header="安全">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="主密码、提示词和保护问题" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="自动锁定只锁定界面，不停止已启用的本地 API。" Foreground="#666" Margin="0,8,0,16"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="自动锁定" VerticalAlignment="Center" Margin="0,0,10,12"/>
                    <ComboBox x:Name="AutoLockBox" Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left" Height="28" Margin="0,0,0,12" SelectionChanged="AutoLockBox_SelectionChanged">
                        <ComboBoxItem Content="关闭" Tag="0"/>
                        <ComboBoxItem Content="5 分钟" Tag="5"/>
                        <ComboBoxItem Content="10 分钟" Tag="10"/>
                        <ComboBoxItem Content="30 分钟" Tag="30"/>
                    </ComboBox>

                    <Button Grid.Row="3" Grid.Column="1" Content="修改安全保护" Width="120" Height="28" HorizontalAlignment="Left" Click="ChangeSecurity_Click"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="ApiTab" Header="API">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="开关" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <CheckBox x:Name="ApiEnabledBox" Grid.Row="0" Grid.Column="1" Content="启用本地 API" VerticalAlignment="Center" Margin="0,0,0,10" Checked="ApiEnabledBox_Changed" Unchecked="ApiEnabledBox_Changed"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="状态" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBlock x:Name="ApiStatusText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="地址" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox x:Name="ApiAddressBox" Grid.Row="2" Grid.Column="1" Height="28" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Token" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox x:Name="ApiTokenBox" Grid.Row="3" Grid.Column="1" Height="28" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="文件" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox x:Name="ApiTokenFileBox" Grid.Row="4" Grid.Column="1" Height="28" IsReadOnly="True" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="输入密码查看" Height="28" Width="104" Margin="0,0,8,0" Click="RevealToken_Click"/>
                        <Button Content="复制" Height="28" Width="62" Margin="0,0,8,0" Click="CopyToken_Click"/>
                        <Button Content="新建" Height="28" Width="62" Margin="0,0,8,0" Click="NewToken_Click"/>
                        <Button Content="删除" Height="28" Width="62" Click="DeleteToken_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Text="关闭 API 后不监听端口。界面锁定后，如果 API 仍启用，已认证的本机脚本仍可继续调用。"
                               Foreground="#666" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="PathTab" Header="路径">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="备份目录" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox x:Name="BackupDirectoryBox" Grid.Row="0" Grid.Column="1" Height="28" IsReadOnly="True" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="修改" Height="28" Width="72" Margin="0,0,8,0" Click="ChooseBackupDirectory_Click"/>
                        <Button Content="打开目录" Height="28" Width="86" Click="OpenBackupDirectory_Click"/>
                        <Button Content="备份历史" Height="28" Width="86" Margin="8,0,0,0" Click="BackupHistory_Click"/>
                        <Button Content="检查数据库" Height="28" Width="92" Margin="8,0,0,0" Click="DatabaseCheck_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="第一次点击备份会要求选择目录，之后点击备份会直接在该目录创建完整数据库备份。备份包含账号、密码、2FA、分类、标签、备注和软件设置。"
                               Foreground="#666" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1" Content="关闭" Width="86" Height="28" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"/>
    </Grid>
</Window>
