<Window x:Class="AccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccountManager.Controls"
        Title="AccountManager" Height="720" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolbarTextButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CopyButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Content" Value="&#xE8C8;"/>
            <Setter Property="ToolTip" Value="复制"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="White">
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="8,8,8,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                <Button Style="{StaticResource ToolbarTextButton}" Content="新增" ToolTip="手动添加一个账号" Click="New_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="快捷导入" ToolTip="粘贴多行账号，填写分类和标签后直接入库" Click="QuickImport_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="文件导入" ToolTip="选择一个或多个 TXT 文件导入" Click="ImportTxt_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="导出TXT" ToolTip="导出当前列表为 TXT" Click="ExportTxt_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="导出CSV" ToolTip="导出当前列表为 CSV" Click="ExportCsv_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="备份" ToolTip="创建完整数据库备份" Click="CreateBackup_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="恢复" ToolTip="从备份恢复数据库" Click="RestoreBackup_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="设置" ToolTip="修改主密码、提示词和保护问题" Click="SecuritySettings_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="锁定" ToolTip="锁定并重新打开解锁页" Click="Lock_Click"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="#555"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" BorderBrush="#B8B8B8" TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#555"/>
        </Border>

        <Grid Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="分类" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox x:Name="CategoryListBox" Grid.Row="1" BorderThickness="0" SelectionChanged="SidebarFilter_SelectionChanged" DisplayMemberPath="DisplayName"/>
                <TextBlock Grid.Row="2" Text="标签" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ListBox x:Name="TagListBox" Grid.Row="3" BorderThickness="0" SelectionChanged="SidebarFilter_SelectionChanged" DisplayMemberPath="DisplayName"/>
            </Grid>

            <Border Grid.Column="1" Background="#DDD"/>

            <Grid Grid.Column="2" Margin="8,0">
                <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderBrush="#DDD" BorderThickness="1"
                          SelectionChanged="AccountsGrid_SelectionChanged"
                          MouseDoubleClick="AccountsGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="AccountsGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制邮箱" Click="CopySelectedEmail_Click"/>
                            <MenuItem Header="复制密码" Click="CopySelectedPassword_Click"/>
                            <MenuItem Header="复制 2FA" Click="CopySelectedTwoFa_Click"/>
                            <MenuItem Header="复制整行" Click="CopySelectedLine_Click"/>
                            <Separator/>
                            <MenuItem Header="删除" Click="Delete_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="邮箱" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Email}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="分类" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Category}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="标签" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Tags}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="备注" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Remark}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="命中" Binding="{Binding MatchField}" Width="70"/>
                        <DataGridTextColumn Header="更新" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyHintText" Text="拖入 TXT 或点击导入" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Column="3" Background="#DDD"/>

            <Grid Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="详情" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="邮箱"/>
                        <TextBox x:Name="EmailBox"
                                 Height="28"
                                 IsReadOnly="True"
                                 ToolTip="单击复制，双击编辑"
                                 PreviewMouseLeftButtonDown="EmailBox_PreviewMouseLeftButtonDown"
                                 LostKeyboardFocus="EmailBox_LostKeyboardFocus"
                                 KeyDown="EditorBox_KeyDown"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="密码"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PasswordBox"
                                     Height="28"
                                     IsReadOnly="True"
                                     ToolTip="单击复制，双击编辑"
                                     PreviewMouseLeftButtonDown="PasswordBox_PreviewMouseLeftButtonDown"
                                     LostKeyboardFocus="PasswordBox_LostKeyboardFocus"
                                     KeyDown="EditorBox_KeyDown"/>
                            <Button x:Name="TogglePasswordButton"
                                    Grid.Column="1"
                                    FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE890;"
                                    Width="34"
                                    Height="26"
                                    Margin="4,0,0,0"
                                    ToolTip="显示/隐藏密码"
                                    Click="TogglePassword_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="2FA"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TwoFaCodeBox"
                                     Height="28"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="15"
                                     ToolTip="单击复制验证码，双击编辑密钥"
                                     PreviewMouseLeftButtonDown="TwoFaCodeBox_PreviewMouseLeftButtonDown"
                                     LostKeyboardFocus="TwoFaCodeBox_LostKeyboardFocus"
                                     KeyDown="EditorBox_KeyDown"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="分类"/>
                        <TextBox x:Name="CategoryBox" Height="28"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="标签"/>
                        <TextBox x:Name="TagsBox" Height="28"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="备注"/>
                        <TextBox x:Name="RemarkBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="复制整行" Width="82" Height="28" Margin="0,0,6,0" ToolTip="复制 邮箱--密码--2FA" Click="CopyLine_Click"/>
                    <Button Content="删除" Width="60" Height="28" Margin="0,0,6,0" Click="Delete_Click"/>
                    <Button Content="保存" Width="60" Height="28" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
