<Window x:Class="AccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccountManager.Controls"
        Title="AccountManager" Height="760" Width="440" MinHeight="560" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolbarTextButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="54"/>
        </Style>
        <Style x:Key="CopyButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Content" Value="&#xE8C8;"/>
            <Setter Property="ToolTip" Value="复制"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="White">
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6">
            <DockPanel LastChildFill="True">
                <Button x:Name="ViewModeButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarTextButton}"
                        Content="展开"
                        ToolTip="切换小窗/大窗布局"
                        Click="ViewModeButton_Click"/>

                <Grid Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="#555"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" BorderBrush="#B8B8B8" TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </DockPanel>

            <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Style="{StaticResource ToolbarTextButton}" Content="新增" ToolTip="手动添加一个账号" Click="New_Click"/>
                <Button Style="{StaticResource ToolbarTextButton}" Content="导入 ▾" ToolTip="快捷导入或文件导入" Click="ToolbarMenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="快捷导入" Click="QuickImport_Click"/>
                            <MenuItem Header="文件导入" Click="ImportTxt_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource ToolbarTextButton}" Content="导出 ▾" ToolTip="导出当前列表" Click="ToolbarMenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="导出 TXT" Click="ExportTxt_Click"/>
                            <MenuItem Header="导出 CSV" Click="ExportCsv_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource ToolbarTextButton}" Content="更多 ▾" ToolTip="备份、恢复、API、设置和锁定" Click="ToolbarMenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="备份" Click="CreateBackup_Click"/>
                            <MenuItem Header="恢复" Click="RestoreBackup_Click"/>
                            <Separator/>
                            <MenuItem Header="API" Click="ApiInfo_Click"/>
                            <MenuItem Header="设置" Click="SecuritySettings_Click"/>
                            <MenuItem Header="锁定" Click="Lock_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#555" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid x:Name="MainContentGrid" Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MainListRow" Height="*"/>
                <RowDefinition x:Name="MainHorizontalSeparatorRow" Height="0"/>
                <RowDefinition x:Name="MainDetailRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterColumn" Width="128"/>
                <ColumnDefinition x:Name="FirstSeparatorColumn" Width="1"/>
                <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="0"/>
                <ColumnDefinition x:Name="SecondSeparatorColumn" Width="1"/>
                <ColumnDefinition x:Name="DetailColumn" Width="270"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="SidebarPanel" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="分类" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox x:Name="CategoryListBox" Grid.Row="1" BorderThickness="0" SelectionChanged="SidebarFilter_SelectionChanged" DisplayMemberPath="DisplayName"/>
                <TextBlock Grid.Row="2" Text="标签" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ListBox x:Name="TagListBox" Grid.Row="3" BorderThickness="0" SelectionChanged="SidebarFilter_SelectionChanged" DisplayMemberPath="DisplayName"/>
            </Grid>

            <Border x:Name="FirstVerticalSeparator" Grid.Row="0" Grid.Column="1" Background="#DDD"/>

            <Grid x:Name="ListPanel" Grid.Row="0" Grid.Column="2" Margin="8,0">
                <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderBrush="#DDD" BorderThickness="1"
                          SelectionChanged="AccountsGrid_SelectionChanged"
                          MouseDoubleClick="AccountsGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="AccountsGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制邮箱" Click="CopySelectedEmail_Click"/>
                            <MenuItem Header="复制密码" Click="CopySelectedPassword_Click"/>
                            <MenuItem Header="复制 2FA" Click="CopySelectedTwoFa_Click"/>
                            <MenuItem Header="复制整行" Click="CopySelectedLine_Click"/>
                            <Separator/>
                            <MenuItem Header="删除" Click="Delete_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="邮箱" Width="2*" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Email}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="分类" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Category}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="标签" Width="*" MinWidth="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Tags}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="更新" Binding="{Binding UpdatedAt, StringFormat=MM-dd HH:mm}" Width="92"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ListBox x:Name="CompactAccountsList"
                         Visibility="Collapsed"
                         BorderBrush="#DDD"
                         BorderThickness="1"
                         SelectionChanged="CompactAccountsList_SelectionChanged"
                         MouseDoubleClick="CompactAccountsList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="CompactAccountsList_PreviewMouseRightButtonDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制邮箱" Click="CopySelectedEmail_Click"/>
                            <MenuItem Header="复制密码" Click="CopySelectedPassword_Click"/>
                            <MenuItem Header="复制 2FA" Click="CopySelectedTwoFa_Click"/>
                            <MenuItem Header="复制整行" Click="CopySelectedLine_Click"/>
                            <Separator/>
                            <MenuItem Header="删除" Click="Delete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="4,6">
                                <StackPanel>
                                    <controls:HighlightedTextBlock TextValue="{Binding Email}"
                                                                   Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Category}" Foreground="#666" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text=" · " Foreground="#999" FontSize="12"/>
                                        <TextBlock Text="{Binding Tags}" Foreground="#666" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text=" · " Foreground="#999" FontSize="12"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat=MM-dd HH:mm}" Foreground="#666" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHintText" Text="拖入 TXT 或点击导入" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" Visibility="Collapsed"/>
            </Grid>

            <Border x:Name="SecondVerticalSeparator" Grid.Row="0" Grid.Column="3" Background="#DDD"/>
            <Border x:Name="HorizontalSeparator" Grid.Row="1" Grid.Column="2" Background="#DDD" Visibility="Collapsed"/>

            <Grid x:Name="DetailPanel" Grid.Row="0" Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="详情" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="邮箱"/>
                        <TextBox x:Name="EmailBox"
                                 Height="28"
                                 IsReadOnly="True"
                                 ToolTip="单击复制，双击编辑"
                                 PreviewMouseLeftButtonDown="EmailBox_PreviewMouseLeftButtonDown"
                                 LostKeyboardFocus="EmailBox_LostKeyboardFocus"
                                 KeyDown="EditorBox_KeyDown"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="密码"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PasswordBox"
                                     Height="28"
                                     IsReadOnly="True"
                                     ToolTip="单击复制，双击编辑"
                                     PreviewMouseLeftButtonDown="PasswordBox_PreviewMouseLeftButtonDown"
                                     LostKeyboardFocus="PasswordBox_LostKeyboardFocus"
                                     KeyDown="EditorBox_KeyDown"/>
                            <Button x:Name="TogglePasswordButton"
                                    Grid.Column="1"
                                    FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE890;"
                                    Width="34"
                                    Height="26"
                                    Margin="4,0,0,0"
                                    ToolTip="显示/隐藏密码"
                                    Click="TogglePassword_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="2FA"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TwoFaCodeBox"
                                     Height="28"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="15"
                                     ToolTip="单击复制验证码，双击编辑密钥"
                                     PreviewMouseLeftButtonDown="TwoFaCodeBox_PreviewMouseLeftButtonDown"
                                     LostKeyboardFocus="TwoFaCodeBox_LostKeyboardFocus"
                                     KeyDown="EditorBox_KeyDown"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="分类"/>
                        <TextBox x:Name="CategoryBox" Height="28"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="标签"/>
                        <TextBox x:Name="TagsBox" Height="28"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="备注"/>
                        <TextBox x:Name="RemarkBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="复制整行" Width="82" Height="28" Margin="0,0,6,0" ToolTip="复制 邮箱--密码--2FA" Click="CopyLine_Click"/>
                    <Button Content="删除" Width="60" Height="28" Margin="0,0,6,0" Click="Delete_Click"/>
                    <Button Content="保存" Width="60" Height="28" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
