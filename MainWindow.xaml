<Window x:Class="AccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccountManager.Controls"
        Title="AccountManager" Height="760" Width="1220" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F4F6FA" BorderBrush="#D6DCE8" BorderThickness="0,0,0,1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="30" TextChanged="SearchBox_TextChanged" ToolTip="支持大小写不敏感、双向部分匹配。例如输入 codex-bqmlutxsw20435@outlook.jp-plus 也能命中邮箱。"/>
                <TextBlock Grid.Column="2" Text="分类" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="CategoryFilterBox" Grid.Column="3" Height="30" SelectionChanged="FilterBox_SelectionChanged"/>
                <TextBlock Grid.Column="4" Text="标签" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="TagFilterBox" Grid.Column="5" Height="30" SelectionChanged="FilterBox_SelectionChanged"/>
                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <Button Content="锁定" Width="74" Margin="0,0,8,0" Click="Lock_Click"/>
                    <Button Content="安全设置" Width="86" Click="SecuritySettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="600"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <ToolBar DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="新增" Click="New_Click"/>
                    <Separator/>
                    <Button Content="导入 TXT" Click="ImportTxt_Click"/>
                    <Button Content="粘贴导入" Click="PasteImport_Click"/>
                    <Separator/>
                    <Button Content="导出 TXT" Click="ExportTxt_Click"/>
                    <Button Content="导出 CSV" Click="ExportCsv_Click"/>
                    <Separator/>
                    <Button Content="创建备份" Click="CreateBackup_Click"/>
                    <Button Content="导入备份" Click="RestoreBackup_Click"/>
                </ToolBar>

                <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                          SelectionChanged="AccountsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTemplateColumn Header="邮箱" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Email}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="分类" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Category}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="标签" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Tags}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="备注" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Remark}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="命中字段" Binding="{Binding MatchField}" Width="90"/>
                        <DataGridTemplateColumn Header="命中内容" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding MatchValue}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="2" BorderBrush="#D6DCE8" BorderThickness="1" CornerRadius="8" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="账号详情" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="删除" Width="72" Margin="0,0,8,0" Click="Delete_Click"/>
                        <Button Content="保存" Width="90" Click="Save_Click"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="邮箱"/>
                            <TextBox x:Name="EmailBox" Height="30" Margin="0,4,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="密码"/>
                                    <TextBox x:Name="PasswordBox" Height="30" Margin="0,4,8,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="复制" Width="62" VerticalAlignment="Bottom" Click="CopyPassword_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="2FA Secret"/>
                                    <TextBox x:Name="TwoFaBox" Height="30" Margin="0,4,8,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="复制" Width="62" VerticalAlignment="Bottom" Click="CopyTwoFa_Click"/>
                            </Grid>

                            <TextBlock Text="分类"/>
                            <TextBox x:Name="CategoryBox" Height="30" Margin="0,4,0,10"/>

                            <TextBlock Text="标签（逗号分隔）"/>
                            <TextBox x:Name="TagsBox" Height="30" Margin="0,4,0,10"/>

                            <TextBlock Text="备注"/>
                            <TextBox x:Name="RemarkBox" Height="90" Margin="0,4,0,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="复制邮箱" Width="86" Margin="0,0,8,8" Click="CopyEmail_Click"/>
                                <Button Content="复制整行" Width="86" Margin="0,0,8,8" Click="CopyLine_Click"/>
                                <Button Content="清空表单" Width="86" Margin="0,0,8,8" Click="New_Click"/>
                            </WrapPanel>

                            <Border Background="#F4F6FA" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                <TextBlock Text="备份说明：创建备份会生成完整加密数据库文件，文件名为 AccountManager_Backup_时间.db。导入备份会替换当前数据库，恢复后需要输入该备份对应的主密码。" TextWrapping="Wrap" Foreground="#555"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
