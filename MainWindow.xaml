<Window x:Class="AccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccountManager.Controls"
        Title="AccountManager" Height="720" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CopyButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Content" Value="&#xE8C8;"/>
            <Setter Property="ToolTip" Value="复制"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="White">
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="8,8,8,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="新增" Click="New_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8B5;" ToolTip="导入 TXT / 多文件" Click="ImportTxt_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE77F;" ToolTip="粘贴导入" Click="PasteImport_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="导出 TXT" Click="ExportTxt_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="导出 CSV" Click="ExportCsv_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE777;" ToolTip="创建备份" Click="CreateBackup_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="导入备份" Click="RestoreBackup_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="安全设置" Click="SecuritySettings_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72E;" ToolTip="锁定" Click="Lock_Click"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="#555"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" BorderBrush="#B8B8B8" TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#555"/>
        </Border>

        <Grid Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="分类" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox x:Name="CategoryListBox" Grid.Row="1" BorderThickness="0" SelectionChanged="SidebarFilter_SelectionChanged" DisplayMemberPath="DisplayName"/>
                <TextBlock Grid.Row="2" Text="标签" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ListBox x:Name="TagListBox" Grid.Row="3" BorderThickness="0" SelectionChanged="SidebarFilter_SelectionChanged" DisplayMemberPath="DisplayName"/>
            </Grid>

            <Border Grid.Column="1" Background="#DDD"/>

            <Grid Grid.Column="2" Margin="8,0">
                <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderBrush="#DDD" BorderThickness="1"
                          SelectionChanged="AccountsGrid_SelectionChanged"
                          MouseDoubleClick="AccountsGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="AccountsGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制邮箱" Click="CopySelectedEmail_Click"/>
                            <MenuItem Header="复制密码" Click="CopySelectedPassword_Click"/>
                            <MenuItem Header="复制 2FA" Click="CopySelectedTwoFa_Click"/>
                            <MenuItem Header="复制整行" Click="CopySelectedLine_Click"/>
                            <Separator/>
                            <MenuItem Header="删除" Click="Delete_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="邮箱" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Email}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="分类" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Category}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="标签" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Tags}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="备注" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HighlightedTextBlock TextValue="{Binding Remark}" Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="命中" Binding="{Binding MatchField}" Width="70"/>
                        <DataGridTextColumn Header="更新" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyHintText" Text="拖入 TXT 或点击导入" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Column="3" Background="#DDD"/>

            <Grid Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="详情" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="邮箱"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EmailBox" Height="28"/>
                            <Button Grid.Column="1" Style="{StaticResource CopyButton}" Click="CopyEmail_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="密码"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordHiddenBox" Height="28"/>
                            <TextBox x:Name="PasswordTextBox" Height="28" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="26" Margin="4,0,0,0" Content="&#xE890;" ToolTip="显示/隐藏" Click="ToggleSecrets_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource CopyButton}" Click="CopyPassword_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="2FA"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TwoFaHiddenBox" Height="28"/>
                            <TextBox x:Name="TwoFaTextBox" Height="28" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="26" Margin="4,0,0,0" Content="&#xE890;" ToolTip="显示/隐藏" Click="ToggleSecrets_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource CopyButton}" Click="CopyTwoFa_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="分类"/>
                        <TextBox x:Name="CategoryBox" Height="28"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="标签"/>
                        <TextBox x:Name="TagsBox" Height="28"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="备注"/>
                        <TextBox x:Name="RemarkBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="复制整行" Click="CopyLine_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="删除" Click="Delete_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="保存" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
