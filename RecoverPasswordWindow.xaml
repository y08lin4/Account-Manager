<Window x:Class="AccountManager.RecoverPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通过保护问题恢复" Height="360" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="重置主密码" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="回答保护问题后，可以设置新的主密码。账号数据不会丢失。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="保护问题" Margin="0,0,12,10"/>
            <TextBlock x:Name="QuestionText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="保护答案" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <PasswordBox x:Name="AnswerBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="新主密码" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <PasswordBox x:Name="NewPasswordBox" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="确认密码" VerticalAlignment="Center" Margin="0,0,12,10"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="新提示词" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="HintBox" Grid.Row="4" Grid.Column="1" Height="30"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="90" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="重置并解锁" Width="120" IsDefault="True" Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</Window>
